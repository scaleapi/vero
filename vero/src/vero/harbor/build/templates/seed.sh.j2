#!/bin/sh
set -eu

if [ ! -d /work/agent/.git ]; then
  cp -a /opt/agent-seed/. /work/agent/
fi

chown -R agent:agent /work/agent
git config --system --add safe.directory /work/agent
{% for path in read_only_paths %}
if [ -e "/work/agent/{{ path }}" ]; then
  chown -R root:root "/work/agent/{{ path }}"
  chmod -R a-w "/work/agent/{{ path }}"
fi
{% endfor %}

exec sleep infinity
