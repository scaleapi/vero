# Trusted inference gateway: upstream credential and durable usage ledger.
FROM {{ base_image_sidecar }}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

{% if use_local_vero %}
COPY vero /opt/vero
RUN uv pip install --system "/opt/vero[harbor]"
{% else %}
RUN uv pip install --system "{{ vero_requirement }}"
{% endif %}

COPY gateway/config.json /opt/inference.json

WORKDIR /opt
