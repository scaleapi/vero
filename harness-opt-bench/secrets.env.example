# Copy this file to a git-ignored location and fill in the values required by
# your deployment. Never commit a populated credential file.

# Inference endpoint used by the gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Add execution-environment credentials required by your Harbor installation.

# Execution environment and telemetry, as declared under `secrets` in build.yaml.
# Edit both together if your deployment uses different services.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=
WANDB_API_KEY=
WANDB_BASE_URL=
