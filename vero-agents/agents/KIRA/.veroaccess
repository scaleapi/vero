# Vero agent filesystem access rules for TerminusKira
# Last matching rule wins (like .gitignore)
#
# Sections:
#   [exclude] - No access at all
#   [read]    - Read-only access
#   [write]   - Read and write access
#
# Goal: Optimizer can modify agent behavior, but NOT read eval outputs or game results

[exclude]
# =============================================================================
# EVAL OUTPUTS - Must be excluded to prevent result peeking / gaming
# =============================================================================

# Harbor job outputs (trial results, rewards, trajectories, verifier output)
jobs
jobs/**

# Pre-built datasets (contain task definitions and metadata)
datasets
datasets/**

# =============================================================================
# NOISE - Not useful for optimization
# =============================================================================
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
.git
.git/**
*.lock
.venv
.venv/**

# Unrelated sub-projects
KIRA-Slack
KIRA-Slack/**
KiraClaw
KiraClaw/**
.github
.github/**

[read]
# =============================================================================
# INFRASTRUCTURE - Readable but not modifiable
# =============================================================================

# Run scripts (understand how the agent is invoked)
run-scripts
run-scripts/**

# Vero task definitions
terminus_kira/vero_tasks
terminus_kira/vero_tasks/**

# Terminal Bench
terminal-bench-2
terminal-bench-2/**

# Config files
pyproject.toml
README.md
LICENSE
.gitignore

# Access rules file: MUST be read-only to prevent agent self-modification
.veroaccess

[write]
# =============================================================================
# AGENT CODE - The optimizer's target
# =============================================================================

# Main agent implementation (primary optimization target)
terminus_kira/__init__.py
terminus_kira/terminus_kira.py

# Prompt templates (tunable)
prompt-templates
prompt-templates/**

# Caching utility
anthropic_caching.py
